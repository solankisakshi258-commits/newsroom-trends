# Copy to .env and fill in the keys for the sources you want to enable.
# Any source whose required keys are missing is SKIPPED (not an error).

# YouTube Data API v3 — https://console.cloud.google.com/ -> APIs & Services
YOUTUBE_API_KEY=

# Reddit script app — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=newsroom-trends/0.1 by yourusername

# Twitter/X API v2 — https://developer.x.com/ (Bearer token, recent search)
TWITTER_BEARER_TOKEN=

# Push-alert webhook. Make.com custom webhook URL, or a Slack incoming webhook URL.
# Leave blank to disable pushing (alerts will still be computed + logged).
ALERT_WEBHOOK_URL=
